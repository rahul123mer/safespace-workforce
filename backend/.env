# Local development configuration for this Windows machine (tracked in git). See .env.example for all options.
EMS_DATABASE_URL=postgresql+psycopg://ems@127.0.0.1:55432/workforce
EMS_STORAGE_DIR=C:/SSGC/SSGC-internal/employee-management/.devdata/storage
EMS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
EMS_COOKIE_SECURE=false
EMS_FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# Recognition pipeline (local): unmodified copy of triton-2-backend's compute/ and
# contract/ in .devdata/pipeline, InsightFace buffalo_l from ~/.insightface, CPU inference.
EMS_COMPUTE_ROOT=C:/SSGC/SSGC-internal/employee-management/.devdata/pipeline/compute
EMS_COMPUTE_PYTHON=C:/SSGC/SSGC-internal/employee-management/.devdata/pipeline/.venv/Scripts/python.exe
EMS_INSIGHTFACE_HOME=C:/Users/rahul/.insightface
EMS_ALLOW_CPU_INFERENCE=true
