# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL 14+ database used by the API and the worker.
EMS_DATABASE_URL=postgresql+psycopg://ems_app:CHANGE_ME@127.0.0.1:5432/workforce

# Where face images and imported footage are stored (created if missing).
EMS_STORAGE_DIR=/var/lib/triton-workforce/storage

# Browser origins allowed to change data (comma separated). Must match the URL users open.
EMS_ALLOWED_ORIGINS=http://localhost:5180
# Set to true when served over HTTPS.
EMS_COOKIE_SECURE=false
EMS_SESSION_TTL_HOURS=12

# Production only: serve the built frontend from the API process.
# EMS_FRONTEND_DIST_DIR=/opt/triton-workforce/frontend/dist

# Existing Triton recognition pipeline (worker host).
EMS_COMPUTE_ROOT=/home/ssgc/Documents/Sourav/triton-2-backend/compute
EMS_COMPUTE_PYTHON=/home/ssgc/Documents/Sourav/triton-2-backend/.venv-compute/bin/python3
EMS_COMPUTE_LIBRARY_PATH=/home/ssgc/Documents/Sourav/SC-Triton/.venv/lib/python3.12/site-packages/nvidia/cu13/lib:/home/ssgc/Documents/Sourav/SC-Triton/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/home/ssgc/Documents/Sourav/SC-Triton/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/home/ssgc/Documents/Sourav/SC-Triton/.venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:/home/ssgc/Documents/Sourav/SC-Triton/.venv/lib/python3.12/site-packages/torch/lib
EMS_INSIGHTFACE_HOME=/home/ssgc/Documents/Sourav/SC-Triton/models/insightface
EMS_ALLOW_CPU_INFERENCE=false
EMS_FACE_REGISTRATION_TIMEOUT_S=180
EMS_FOOTAGE_ANALYSIS_TIMEOUT_S=14400

# Upload limits (bytes) and tools.
EMS_MAX_FACE_IMAGE_BYTES=10485760
EMS_MAX_FOOTAGE_BYTES=8589934592
EMS_FFPROBE_PATH=ffprobe

# Worker
EMS_WORKER_POLL_SECONDS=2
EMS_JOB_LEASE_SECONDS=600
